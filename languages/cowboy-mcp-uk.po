msgstr "Desktop Connector увімкнено."

#: admin/class-mcp-admin.php:207
msgid "Settings saved."
msgstr "Налаштування збережено."

#: admin/class-mcp-admin.php:214
msgid "Audit log cleared."
msgstr "Журнал аудиту очищено."

