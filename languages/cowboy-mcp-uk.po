msgstr ""
"Додайте це до <code>claude_desktop_config.json</code>, потім повністю "
"закрийте застосунок Claude і відкрийте його знову."

#: admin/class-mcp-admin-connections.php:668
msgid ""
"macOS: <code>~/Library/Application Support/Claude/"
"claude_desktop_config.json</code>"
msgstr ""
"macOS: <code>~/Library/Application Support/Claude/"
"claude_desktop_config.json</code>"

#: admin/class-mcp-admin-connections.php:669
msgid "Windows: <code>%APPDATA%\\Claude\\claude_desktop_config.json</code>"
msgstr "Windows: <code>%APPDATA%\\Claude\\claude_desktop_config.json</code>"

#: admin/class-mcp-admin-connections.php:674
#: admin/class-mcp-admin-connections.php:915
