#: admin/class-mcp-admin.php:163 admin/class-mcp-admin.php:183
#: admin/class-mcp-admin.php:205
msgid "Select an access level before saving."
msgstr "Seleziona un livello di accesso prima di salvare."

#: admin/class-mcp-admin.php:167
