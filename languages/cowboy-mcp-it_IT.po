#. translators: %s: human-readable time difference
#: admin/class-mcp-admin.php:856 admin/class-mcp-admin.php:926
#, php-format
msgid "%s ago"
msgstr "%s fa"

#: admin/class-mcp-admin.php:858 admin/class-mcp-admin.php:928
msgid "never"
msgstr "mai"

#: admin/class-mcp-admin.php:863 admin/class-mcp-admin.php:933
msgid "Edit"
