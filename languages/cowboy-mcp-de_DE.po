msgstr ""
"ChatGPT hat Ihre Website gefunden — bestätigen Sie den Zugriff auf der "
"Anmeldeseite."

#: admin/class-mcp-admin-connections.php:78
msgid "Claude found your site — approve access on the sign-in page."
msgstr ""
"Claude hat Ihre Website gefunden — bestätigen Sie den Zugriff auf der "
"Anmeldeseite."

#: admin/class-mcp-admin-connections.php:79
msgid "Approved — waiting for ChatGPT's first request."
msgstr "Genehmigt — warte auf die erste Anfrage von ChatGPT."

#: admin/class-mcp-admin-connections.php:79
msgid "Approved — waiting for Claude's first request."
msgstr "Genehmigt — warte auf die erste Anfrage von Claude."

#: admin/class-mcp-admin-connections.php:81
