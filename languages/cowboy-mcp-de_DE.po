msgstr "✓ Verbunden — ChatGPT hat Ihre frühere Verbindung wiederverwendet."

#: admin/class-mcp-admin-connections.php:81
msgid "✓ Connected — Claude reused your earlier connection."
msgstr "✓ Verbunden — Claude hat Ihre frühere Verbindung wiederverwendet."

#: admin/class-mcp-admin-connections.php:82
msgid "✓ Connected — ChatGPT can now use this site."
msgstr "✓ Verbunden — ChatGPT kann diese Website jetzt nutzen."

#: admin/class-mcp-admin-connections.php:82
msgid "✓ Connected — Claude can now use this site."
msgstr "✓ Verbunden — Claude kann diese Website jetzt nutzen."

#: admin/class-mcp-admin-connections.php:83
msgid "ChatGPT tried to connect, but new connections were off."
msgstr ""
"ChatGPT hat versucht, eine Verbindung herzustellen, aber neue Verbindungen "
"waren deaktiviert."

#: admin/class-mcp-admin-connections.php:83
msgid "Claude tried to connect, but new connections were off."
msgstr ""
"Claude hat versucht, eine Verbindung herzustellen, aber neue Verbindungen "
"waren deaktiviert."

#: admin/class-mcp-admin-connections.php:84
msgid "Waiting for ChatGPT…"
msgstr "Warte auf ChatGPT …"

#: admin/class-mcp-admin-connections.php:84
msgid "Waiting for Claude…"
