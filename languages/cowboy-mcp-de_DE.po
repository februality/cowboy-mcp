msgstr "Checkpoint gelöscht."

#: admin/class-mcp-admin.php:338
msgid "Connect AI agents like <strong>Claude</strong>, <strong>ChatGPT</strong>, or <strong>Codex</strong> to this WordPress site over the Model Context Protocol."
msgstr "Verbinden Sie KI-Agenten wie <strong>Claude</strong>, <strong>ChatGPT</strong> oder <strong>Codex</strong> über das Model Context Protocol mit dieser WordPress-Website."

#: admin/class-mcp-admin.php:344
msgid "Connection"
msgstr "Verbindung"

#: admin/class-mcp-admin.php:345
msgid "Settings"
msgstr "Einstellungen"

#: admin/class-mcp-admin.php:346
msgid "Activity"
msgstr "Aktivität"

