#: admin/class-mcp-admin-connections.php:811
#, php-format
msgid ""
"Add this to <code>%1$s</code> (merge it if the file exists), then run "
"<code>muse mcp login %2$s</code>."
msgstr ""
"Fügen Sie dies in <code>%1$s</code> ein (bei vorhandener Datei "
"zusammenführen) und führen Sie dann <code>muse mcp login %2$s</code> aus."

