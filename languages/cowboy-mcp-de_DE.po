msgstr "Fügen Sie dies zu <code>~/.cursor/mcp.json</code> hinzu (erstellen Sie die Datei, falls sie nicht existiert), und laden Sie Cursor anschließend neu:"

#: admin/class-mcp-admin.php:722
msgid "Copy setup command"
msgstr "Einrichtungsbefehl kopieren"

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:733
#, php-format
msgid "Open a new Claude Code session and run <code>/mcp</code> — <code>%s</code> should be listed as connected."
msgstr "Öffnen Sie eine neue Claude-Code-Sitzung und führen Sie <code>/mcp</code> aus — <code>%s</code> sollte als verbunden aufgeführt sein."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:735
#, php-format
msgid "Run <code>codex mcp list</code> — <code>%s</code> should appear in the list."
msgstr "Führen Sie <code>codex mcp list</code> aus — <code>%s</code> sollte in der Liste erscheinen."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:737
#, php-format
msgid "Restart Opencode and ask it to list its MCP servers — <code>%s</code> should be available."
msgstr "Starten Sie Opencode neu und lassen Sie sich die MCP-Server auflisten — <code>%s</code> sollte verfügbar sein."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:739
#, php-format
msgid "Open <code>Cursor Settings → MCP</code> — <code>%s</code> should appear with a green status dot."
msgstr "Öffnen Sie <code>Cursor Settings → MCP</code> — <code>%s</code> sollte mit einem grünen Statuspunkt erscheinen."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:741
#, php-format
msgid "Run <code>gemini mcp list</code> — <code>%s</code> should show as connected."
msgstr "Führen Sie <code>gemini mcp list</code> aus — <code>%s</code> sollte als verbunden angezeigt werden."

#: admin/class-mcp-admin.php:748
msgid "Check it worked"
msgstr "Überprüfen Sie, ob es funktioniert hat"

#: admin/class-mcp-admin.php:761
