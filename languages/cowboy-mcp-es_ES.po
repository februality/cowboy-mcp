msgstr "Eliminar"

#: admin/class-mcp-admin-activity.php:358
msgid "Delete this checkpoint?"
msgstr "¿Eliminar este punto de control?"

#: admin/class-mcp-admin-connections.php:78
msgid "ChatGPT found your site — approve access on the sign-in page."
msgstr ""
"ChatGPT encontró su sitio — apruebe el acceso en la página de inicio de "
"sesión."

#: admin/class-mcp-admin-connections.php:78
msgid "Claude found your site — approve access on the sign-in page."
msgstr ""
"Claude encontró su sitio — apruebe el acceso en la página de inicio de "
"sesión."

#: admin/class-mcp-admin-connections.php:79
msgid "Approved — waiting for ChatGPT's first request."
msgstr "Aprobado — esperando la primera solicitud de ChatGPT."

#: admin/class-mcp-admin-connections.php:79
msgid "Approved — waiting for Claude's first request."
msgstr "Aprobado — esperando la primera solicitud de Claude."

#: admin/class-mcp-admin-connections.php:81
msgid "✓ Connected — ChatGPT reused your earlier connection."
msgstr "✓ Conectado — ChatGPT reutilizó su conexión anterior."

#: admin/class-mcp-admin-connections.php:81
msgid "✓ Connected — Claude reused your earlier connection."
msgstr "✓ Conectado — Claude reutilizó su conexión anterior."

#: admin/class-mcp-admin-connections.php:82
msgid "✓ Connected — ChatGPT can now use this site."
msgstr "✓ Conectado — ChatGPT ya puede usar este sitio."

#: admin/class-mcp-admin-connections.php:82
msgid "✓ Connected — Claude can now use this site."
msgstr "✓ Conectado — Claude ya puede usar este sitio."

#: admin/class-mcp-admin-connections.php:83
msgid "ChatGPT tried to connect, but new connections were off."
msgstr ""
"ChatGPT intentó conectarse, pero las nuevas conexiones estaban desactivadas."

#: admin/class-mcp-admin-connections.php:83
msgid "Claude tried to connect, but new connections were off."
msgstr ""
"Claude intentó conectarse, pero las nuevas conexiones estaban desactivadas."

#: admin/class-mcp-admin-connections.php:84
msgid "Waiting for ChatGPT…"
msgstr "Esperando a ChatGPT…"

#: admin/class-mcp-admin-connections.php:84
msgid "Waiting for Claude…"
msgstr "Esperando a Claude…"

