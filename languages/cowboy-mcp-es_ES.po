msgstr "¡Cowboy MCP está activo!"

#: admin/class-mcp-admin.php:90
msgid "Connect Claude, Cursor, or any MCP client — it takes about a minute."
msgstr "Conecte Claude, Cursor o cualquier cliente MCP: tarda alrededor de un minuto."

#: admin/class-mcp-admin.php:91
msgid "Connect your AI"
msgstr "Conecte su IA"

#: admin/class-mcp-admin.php:241 admin/class-mcp-admin.php:261
#: admin/class-mcp-admin.php:283
msgid "Select an access level before saving."
msgstr "Selecciona un nivel de acceso antes de guardar."

#: admin/class-mcp-admin.php:245
msgid "API key created. Copy it now — it will only be shown once."
msgstr "Clave API creada. Cópiela ahora — solo se mostrará una vez."

#: admin/class-mcp-admin.php:253
msgid "API key revoked."
msgstr "Clave API revocada."

#: admin/class-mcp-admin.php:263
