#: admin/class-mcp-admin-connections.php:111
#, php-format
msgid "%s found your site — approve access on the sign-in page."
msgstr "%s menemukan situs Anda — setujui akses di halaman masuk."

#. translators: %s: AI app name, e.g. Claude Code
#: admin/class-mcp-admin-connections.php:114
#, php-format
