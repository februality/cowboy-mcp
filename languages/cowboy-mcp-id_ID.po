msgstr "Cowboy MCP"

#: admin/class-mcp-admin.php:159
msgid "API key created. Copy it now — it will only be shown once."
msgstr "Kunci API dibuat. Salin sekarang — kunci hanya akan ditampilkan sekali."

#: admin/class-mcp-admin.php:166
msgid "API key revoked."
msgstr "Kunci API dicabut."

#: admin/class-mcp-admin.php:174
