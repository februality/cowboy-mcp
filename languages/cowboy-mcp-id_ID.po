msgstr "Menulis file di mana saja"

#: admin/class-mcp-admin-settings.php:109
msgid "Requests to internal addresses"
msgstr "Permintaan ke alamat internal"

#: admin/class-mcp-admin-settings.php:113
msgid "Always stays protected"
msgstr "Selalu tetap terlindungi"

#: admin/class-mcp-admin-settings.php:115
msgid "Your MCP API keys"
msgstr "Kunci API MCP Anda"

#: admin/class-mcp-admin-settings.php:116
msgid "The plugin's own settings"
msgstr "Pengaturan plugin itu sendiri"

#: admin/class-mcp-admin-settings.php:117
msgid "Self-delete and last-admin guards"
msgstr "Perlindungan hapus diri sendiri dan administrator terakhir"

#: admin/class-mcp-admin-settings.php:118
