#: admin/class-mcp-admin.php:30 admin/class-mcp-admin.php:31
#: admin/class-mcp-admin.php:498
msgid "Cowboy MCP"
msgstr "Cowboy MCP"

#: admin/class-mcp-admin.php:90
msgid "Cowboy MCP is active!"
msgstr "Cowboy MCP सक्रिय है!"

#: admin/class-mcp-admin.php:91
msgid "Connect Claude, Cursor, or any MCP client — it takes about a minute."
msgstr "Claude, Cursor या किसी भी MCP क्लाइंट को जोड़ें — इसमें लगभग एक मिनट लगता है।"

#: admin/class-mcp-admin.php:92
msgid "Connect your AI"
msgstr "अपना AI जोड़ें"

#: admin/class-mcp-admin.php:158 admin/class-mcp-admin.php:615
msgid "New connections: disabled"
msgstr "नए कनेक्शन: अक्षम"

#: admin/class-mcp-admin.php:159 admin/class-mcp-admin.php:624
msgid "Enable for 30 minutes"
msgstr "30 मिनट के लिए सक्षम करें"

#: admin/class-mcp-admin.php:247 admin/class-mcp-admin.php:267
#: admin/class-mcp-admin.php:289
msgid "Select an access level before saving."
msgstr "सेव करने से पहले एक एक्सेस स्तर चुनें।"

#: admin/class-mcp-admin.php:251
msgid "API key created. Copy it now — it will only be shown once."
msgstr "API कुंजी बनाई गई। इसे अभी कॉपी करें — यह केवल एक बार दिखाई जाएगी।"

#: admin/class-mcp-admin.php:259
msgid "API key revoked."
msgstr "API कुंजी रद्द की गई।"

#: admin/class-mcp-admin.php:269
msgid "Key scope updated. It takes effect on the key's next request."
msgstr "कुंजी का स्कोप अपडेट किया गया। यह इस कुंजी के अगले अनुरोध पर प्रभावी होगा।"

#: admin/class-mcp-admin.php:271
msgid "Could not update key scope."
msgstr "कुंजी का स्कोप अपडेट नहीं किया जा सका।"

#: admin/class-mcp-admin.php:280
msgid "Connection revoked."
msgstr "कनेक्शन रद्द किया गया।"

#: admin/class-mcp-admin.php:291
msgid ""
"Connection scope updated. It takes effect on the connection's next request."
msgstr "कनेक्शन का स्कोप अपडेट किया गया। यह इस कनेक्शन के अगले अनुरोध पर प्रभावी होगा।"

#: admin/class-mcp-admin.php:293
msgid "Could not update connection scope."
msgstr "कनेक्शन का स्कोप अपडेट नहीं किया जा सका।"

#: admin/class-mcp-admin.php:307
msgid "Desktop Connector enabled."
msgstr "डेस्कटॉप कनेक्टर सक्षम किया गया।"

#: admin/class-mcp-admin.php:341
msgid "Settings saved."
msgstr "सेटिंग्स सहेजी गईं।"

#: admin/class-mcp-admin.php:348
msgid "Audit log cleared."
msgstr "ऑडिट लॉग साफ़ किया गया।"

#. translators: 1: change ID number, 2: optional note appended after the message
#: admin/class-mcp-admin.php:366
#, php-format
msgid "Change #%1$d undone.%2$s"
msgstr "परिवर्तन #%1$d पूर्ववत किया गया।%2$s"

#. translators: 1: number of entries undone, 2: total number of entries in the batch
#: admin/class-mcp-admin.php:381
#, php-format
msgid "%1$d of %2$d batch entries undone."
msgstr "%2$d में से %1$d बैच प्रविष्टियाँ पूर्ववत की गईं।"

#. translators: 1: checkpoint ID number, 2: human-readable file size
#: admin/class-mcp-admin.php:397
#, php-format
msgid "Checkpoint #%1$d created (%2$s)."
msgstr "चेकपॉइंट #%1$d बनाया गया (%2$s)।"

#. translators: 1: restored checkpoint ID number, 2: pre-restore safety checkpoint ID number
#: admin/class-mcp-admin.php:409
#, php-format
msgid ""
"Database restored from checkpoint #%1$d. Pre-restore safety checkpoint: "
"#%2$d."
msgstr ""
"डेटाबेस को चेकपॉइंट #%1$d से पुनर्स्थापित किया गया। पुनर्स्थापना-पूर्व सुरक्षा चेकपॉइंट: "
"#%2$d।"

#: admin/class-mcp-admin.php:420
msgid "Checkpoint deleted."
msgstr "चेकपॉइंट हटाया गया।"

#: admin/class-mcp-admin.php:504
msgid ""
"Connect AI agents like <strong>Claude</strong>, <strong>ChatGPT</strong>, or "
"<strong>Codex</strong> to this WordPress site over the Model Context "
"Protocol."
msgstr ""
"<strong>Claude</strong>, <strong>ChatGPT</strong>, या <strong>Codex</strong> "
"जैसे AI एजेंट्स को Model Context Protocol के माध्यम से इस WordPress साइट से कनेक्ट करें।"

#: admin/class-mcp-admin.php:510
msgid "Connection"
msgstr "कनेक्शन"

#: admin/class-mcp-admin.php:511
msgid "Settings"
msgstr "सेटिंग्स"

#: admin/class-mcp-admin.php:512
msgid "Activity"
msgstr "गतिविधि"

#: admin/class-mcp-admin.php:513
msgid "Logs"
msgstr "लॉग"

#: admin/class-mcp-admin.php:514
msgid "About"
msgstr "परिचय"

#. translators: %s: Model Context Protocol website URL.
#: admin/class-mcp-admin.php:541
#, php-format
msgid ""
"<strong>Cowboy MCP</strong> turns this WordPress site into a <a href=\"%s\" "
"target=\"_blank\" rel=\"noopener noreferrer\">Model Context Protocol</a> "
"server, so AI coding agents like Claude Code, Codex, and Opencode can read, "
"edit, and manage the whole site through a single authenticated endpoint."
msgstr ""
"<strong>Cowboy MCP</strong> इस WordPress साइट को एक <a href=\"%s\" "
"target=\"_blank\" rel=\"noopener noreferrer\">Model Context Protocol</a> "
"सर्वर में बदल देता है, ताकि Claude Code, Codex, और Opencode जैसे AI कोडिंग एजेंट्स पूरी "
"साइट को एक ही प्रमाणित एंडपॉइंट के माध्यम से पढ़, संपादित और प्रबंधित कर सकें।"

#: admin/class-mcp-admin.php:555
msgid "Website"
msgstr "वेबसाइट"

#: admin/class-mcp-admin.php:556
msgid "Project home, guides, and news."
msgstr "प्रोजेक्ट होम, गाइड और समाचार।"

#: admin/class-mcp-admin.php:562
msgid "GitHub"
msgstr "GitHub"

#: admin/class-mcp-admin.php:563
msgid "Source, issues & releases."
msgstr "स्रोत, इश्यू और रिलीज़।"

#: admin/class-mcp-admin.php:569
msgid "Get help"
msgstr "सहायता प्राप्त करें"

#: admin/class-mcp-admin.php:570
msgid ""
"Ask in the WordPress.org support forum. Paste your Connection Doctor report "
"for a fast answer."
msgstr ""
"WordPress.org सपोर्ट फ़ोरम में पूछें। तेज़ जवाब के लिए अपनी कनेक्शन डायग्नोस्टिक रिपोर्ट "
"पेस्ट करें।"

#: admin/class-mcp-admin.php:576 admin/class-mcp-feedback.php:192
msgid "Leave a review"
msgstr "समीक्षा लिखें"

#: admin/class-mcp-admin.php:577
msgid ""
"Enjoying Cowboy MCP? A review on WordPress.org helps other site owners find "
"it."
msgstr ""
"Cowboy MCP पसंद आ रहा है? WordPress.org पर एक समीक्षा अन्य साइट मालिकों को इसे "
"खोजने में मदद करती है।"

#. translators: %s: plugin version number
#: admin/class-mcp-admin.php:585
#, php-format
msgid "v%s · GPL-2.0"
msgstr "v%s · GPL-2.0"

#: admin/class-mcp-admin.php:615
msgid "New connections: enabled"
msgstr "नए कनेक्शन: सक्षम"

#. translators: %s: countdown such as 29:59
#: admin/class-mcp-admin.php:619
#, php-format
msgid "%s left"
msgstr "%s शेष"

#: admin/class-mcp-admin.php:624
msgid "Disable now"
msgstr "अभी अक्षम करें"

#: admin/class-mcp-admin.php:627
msgid ""
"Step one when adding ChatGPT or a Claude app: enable this, then add the app. "
"It switches itself off after 30 minutes. API keys do not use it, and "
"connections that already exist keep working either way."
msgstr ""
"ChatGPT या Claude ऐप जोड़ते समय पहला चरण: इसे सक्षम करें, फिर ऐप जोड़ें। यह 30 मिनट "
"बाद स्वयं बंद हो जाता है। API कुंजियाँ इसका उपयोग नहीं करतीं, और मौजूदा कनेक्शन किसी भी "
"स्थिति में काम करते रहते हैं।"

#: admin/class-mcp-admin.php:644
msgid "Which app do you want to connect?"
msgstr "आप कौन सा ऐप कनेक्ट करना चाहते हैं?"

#: admin/class-mcp-admin.php:645
msgid ""
"Pick your AI app or coding tool from the list to see step-by-step setup "
"instructions."
msgstr "चरण-दर-चरण सेटअप निर्देश देखने के लिए सूची से अपना AI ऐप या कोडिंग टूल चुनें।"

#: admin/class-mcp-admin.php:671
msgid "Connection Doctor"
msgstr "कनेक्शन डायग्नोस्टिक"

#: admin/class-mcp-admin.php:672
msgid ""
"Test whether AI clients can reach this site and get a copy-pasteable "
"diagnosis for anything broken."
msgstr ""
"परीक्षण करें कि क्या AI क्लाइंट इस साइट तक पहुँच सकते हैं और किसी भी समस्या के लिए कॉपी-"
"पेस्ट करने योग्य डायग्नोसिस प्राप्त करें।"

#: admin/class-mcp-admin.php:673
msgid "Run checks"
msgstr "जांच चलाएं"

#: admin/class-mcp-admin.php:674
msgid "Copy report"
msgstr "रिपोर्ट कॉपी करें"

#: admin/class-mcp-admin.php:675
msgid "Get help on WordPress.org"
msgstr "WordPress.org पर सहायता प्राप्त करें"

#: admin/class-mcp-admin.php:686
msgid "No terminal needed"
msgstr "किसी टर्मिनल की आवश्यकता नहीं"

#: admin/class-mcp-admin.php:687
msgid "Terminal & IDE tools"
msgstr "टर्मिनल और IDE टूल"

#: admin/class-mcp-admin.php:691
msgid "AI clients"
msgstr "AI क्लाइंट"

#: admin/class-mcp-admin.php:714
msgid "Needs public URL"
msgstr "सार्वजनिक URL आवश्यक"

#: admin/class-mcp-admin.php:716
msgid "Works locally"
msgstr "लोकल पर काम करता है"

#: admin/class-mcp-admin.php:736
msgid ""
"Site actually on a public HTTPS address? Use the cloud connector instead"
msgstr ""
"क्या साइट वास्तव में सार्वजनिक HTTPS पते पर है? तो इसके बजाय क्लाउड कनेक्टर का उपयोग करें"

#: admin/class-mcp-admin.php:769 admin/class-mcp-admin.php:880
msgid ""
"<strong>Heads up:</strong> this site does not appear to be on a public HTTPS "
"address. ChatGPT connects from OpenAI's cloud, so it cannot reach local, "
"private, or non-HTTPS sites. A terminal tool works here instead, or connect "
"through a tunnel/staging URL."
msgstr ""
"<strong>ध्यान दें:</strong> ऐसा प्रतीत होता है कि यह साइट किसी सार्वजनिक HTTPS पते "
"पर नहीं है। ChatGPT OpenAI के क्लाउड से कनेक्ट होता है, इसलिए यह लोकल, निजी या गैर-"
"HTTPS साइटों तक नहीं पहुँच सकता। यहाँ इसके बजाय एक टर्मिनल टूल काम करता है, या किसी "
"टनल/स्टेजिंग URL के माध्यम से कनेक्ट करें।"

#: admin/class-mcp-admin.php:770 admin/class-mcp-admin.php:881
msgid ""
"<strong>Heads up:</strong> this site does not appear to be on a public HTTPS "
"address. The Claude apps connect from Anthropic's cloud, so they cannot "
"reach local, private, or non-HTTPS sites. A terminal tool works here "
"instead, or connect through a tunnel/staging URL."
msgstr ""
"<strong>ध्यान दें:</strong> ऐसा प्रतीत होता है कि यह साइट किसी सार्वजनिक HTTPS पते "
"पर नहीं है। Claude ऐप्स Anthropic के क्लाउड से कनेक्ट होते हैं, इसलिए वे लोकल, निजी या "
"गैर-HTTPS साइटों तक नहीं पहुँच सकते। यहाँ इसके बजाय एक टर्मिनल टूल काम करता है, या किसी "
"टनल/स्टेजिंग URL के माध्यम से कनेक्ट करें।"

#: admin/class-mcp-admin.php:772
msgid ""
"This opens a secure sign-in so ChatGPT can connect without a terminal. No "
"access is granted until you approve it in your browser."
msgstr ""
"यह एक सुरक्षित साइन-इन खोलता है ताकि ChatGPT बिना टर्मिनल के कनेक्ट हो सके। जब तक आप "
"इसे अपने ब्राउज़र में स्वीकृत नहीं करते, तब तक कोई एक्सेस नहीं दिया जाता।"

#: admin/class-mcp-admin.php:773
msgid ""
"This opens a secure sign-in so the Claude apps can connect without a "
"terminal. No access is granted until you approve it in your browser."
msgstr ""
"यह एक सुरक्षित साइन-इन खोलता है ताकि Claude ऐप्स बिना टर्मिनल के कनेक्ट हो सकें। जब तक "
"आप इसे अपने ब्राउज़र में स्वीकृत नहीं करते, तब तक कोई एक्सेस नहीं दिया जाता।"

#: admin/class-mcp-admin.php:775
msgid "You'll paste this into ChatGPT in the next step."
msgstr "आप इसे अगले चरण में ChatGPT में पेस्ट करेंगे।"

#: admin/class-mcp-admin.php:776
msgid "You'll paste this into Claude in the next step."
msgstr "आप इसे अगले चरण में Claude में पेस्ट करेंगे।"

#: admin/class-mcp-admin.php:778
msgid "Add it in ChatGPT"
msgstr "इसे ChatGPT में जोड़ें"

#: admin/class-mcp-admin.php:779
msgid "Add it in the Claude app"
msgstr "इसे Claude ऐप में जोड़ें"

#: admin/class-mcp-admin.php:780
msgid "Add it on claude.ai"
msgstr "इसे claude.ai पर जोड़ें"

#: admin/class-mcp-admin.php:783
msgid ""
"ChatGPT opens a sign-in page on <strong>your site</strong>. Review what it "
"is asking for and click <strong>Approve</strong>. That is it — you are "
"connected."
msgstr ""
"ChatGPT <strong>आपकी साइट</strong> पर एक साइन-इन पेज खोलता है। यह क्या माँग रहा "
"है उसकी समीक्षा करें और <strong>स्वीकृत करें</strong> पर क्लिक करें। बस इतना ही — आप "
"कनेक्ट हो गए हैं।"

#: admin/class-mcp-admin.php:784
msgid ""
"Claude opens a sign-in page on <strong>your site</strong>. Review what it is "
"asking for and click <strong>Approve</strong>. That is it — you are "
"connected."
msgstr ""
"Claude <strong>आपकी साइट</strong> पर एक साइन-इन पेज खोलता है। यह क्या माँग रहा है "
"उसकी समीक्षा करें और <strong>स्वीकृत करें</strong> पर क्लिक करें। बस इतना ही — आप कनेक्ट "
"हो गए हैं।"

#: admin/class-mcp-admin.php:786
msgid ""
"Custom connectors require a paid ChatGPT plan with <strong>Developer mode</"
"strong> (beta) enabled."
msgstr ""
"कस्टम कनेक्टर के लिए एक सशुल्क ChatGPT प्लान की आवश्यकता होती है जिसमें "
"<strong>Developer mode</strong> (बीटा) सक्षम हो।"

#: admin/class-mcp-admin.php:787
msgid ""
"Custom connectors require a Claude <strong>Pro, Max, Team, or Enterprise</"
"strong> plan."
msgstr ""
"कस्टम कनेक्टर के लिए एक Claude <strong>Pro, Max, Team, या Enterprise</strong> "
"प्लान की आवश्यकता होती है।"

#: admin/class-mcp-admin.php:807
msgid "Turn on the Desktop Connector"
msgstr "डेस्कटॉप कनेक्टर चालू करें"

#: admin/class-mcp-admin.php:813
msgid "Enable Desktop Connector"
msgstr "डेस्कटॉप कनेक्टर सक्षम करें"

#: admin/class-mcp-admin.php:824
msgid "Copy your connection link"
msgstr "अपना कनेक्शन लिंक कॉपी करें"

#: admin/class-mcp-admin.php:831 admin/class-mcp-admin.php:923
#: admin/class-mcp-admin.php:971 admin/class-mcp-admin.php:1014
#: admin/class-mcp-admin.php:1056
msgid "Copy"
msgstr "कॉपी करें"

#: admin/class-mcp-admin.php:831
msgid "Copy connector URL"
msgstr "कनेक्टर URL कॉपी करें"

#: admin/class-mcp-admin.php:843
msgid ""
"Go to <code>chatgpt.com</code> (or open the ChatGPT desktop app) and sign in."
msgstr ""
"<code>chatgpt.com</code> पर जाएँ (या ChatGPT डेस्कटॉप ऐप खोलें) और साइन इन करें।"

#: admin/class-mcp-admin.php:844
msgid ""
"Go to <code>Settings → Connectors → Advanced</code> and turn on "
"<strong>Developer mode</strong> (one-time)."
msgstr ""
"<code>Settings → Connectors → Advanced</code> पर जाएँ और <strong>Developer "
"mode</strong> चालू करें (एक बार)।"

#: admin/class-mcp-admin.php:845
msgid "Back in <code>Connectors</code>, click <strong>Create</strong>."
msgstr ""
"<code>Connectors</code> पर वापस जाकर <strong>Create</strong> पर क्लिक करें।"

#: admin/class-mcp-admin.php:846
msgid ""
"Paste the link from step 1 as the <strong>MCP server URL</strong>, set "
"Authentication to <strong>OAuth</strong>, and click <strong>Create</strong>."
msgstr ""
"चरण 1 का लिंक <strong>MCP server URL</strong> के रूप में पेस्ट करें, Authentication "
"को <strong>OAuth</strong> पर सेट करें, और <strong>Create</strong> पर क्लिक करें।"

#: admin/class-mcp-admin.php:849
msgid "Open the <strong>Claude</strong> desktop app and sign in."
msgstr "<strong>Claude</strong> डेस्कटॉप ऐप खोलें और साइन इन करें।"

#: admin/class-mcp-admin.php:851
msgid "Go to <code>claude.ai</code> in your browser and sign in."
msgstr "अपने ब्राउज़र में <code>claude.ai</code> पर जाएँ और साइन इन करें।"

#: admin/class-mcp-admin.php:853
msgid "Go to <code>Customize → Connections</code>."
msgstr "<code>Customize → Connections</code> पर जाएँ।"

#: admin/class-mcp-admin.php:854
msgid "Click <strong>Add custom connector</strong>."
msgstr "<strong>Add custom connector</strong> पर क्लिक करें।"

#: admin/class-mcp-admin.php:855
msgid "Paste the link from step 1 and click <strong>Add</strong>."
msgstr "चरण 1 का लिंक पेस्ट करें और <strong>Add</strong> पर क्लिक करें।"

#: admin/class-mcp-admin.php:864
msgid "Approve access"
msgstr "एक्सेस स्वीकृत करें"

#: admin/class-mcp-admin.php:885
msgid "What works on a local site:"
msgstr "लोकल साइट पर क्या काम करता है:"

#: admin/class-mcp-admin.php:887
msgid ""
"<strong>Terminal tools</strong> (Claude Code, Codex, Cursor, Gemini CLI) — "
"connect right now, no public URL needed. Pick one in the sidebar."
msgstr ""
"<strong>टर्मिनल टूल</strong> (Claude Code, Codex, Cursor, Gemini CLI) — अभी "
"कनेक्ट करें, सार्वजनिक URL की ज़रूरत नहीं। साइडबार में कोई एक चुनें।"

#: admin/class-mcp-admin.php:888
msgid ""
"<strong>Claude Desktop</strong> — connects through a local bridge that runs "
"on this computer. Pick it in the sidebar for instructions."
msgstr ""
"<strong>Claude Desktop</strong> — इस कंप्यूटर पर चलने वाले लोकल ब्रिज के ज़रिए कनेक्ट "
"होता है। निर्देशों के लिए साइडबार में इसे चुनें।"

#: admin/class-mcp-admin.php:889
msgid ""
"<strong>claude.ai and ChatGPT</strong> — cloud-only: they need a public "
"HTTPS address. A tunnel (e.g. ngrok or Cloudflare Tunnel) works temporarily, "
"but it exposes your entire dev site to the internet while it runs, and the "
"WordPress Site Address must be set to the tunnel URL for the sign-in to work."
msgstr ""
"<strong>claude.ai और ChatGPT</strong> — केवल क्लाउड: इन्हें सार्वजनिक HTTPS पता "
"चाहिए। टनल (जैसे ngrok या Cloudflare Tunnel) अस्थायी रूप से काम करती है, लेकिन चलते "
"समय आपकी पूरी डेव साइट इंटरनेट पर उजागर हो जाती है, और साइन-इन के काम करने के लिए "
"WordPress साइट पता टनल URL पर सेट करना होगा।"

#: admin/class-mcp-admin.php:908
msgid ""
"This site runs on your computer, so the cloud connector cannot reach it. "
"Connect Claude Desktop through a <strong>local bridge</strong> instead: a "
"small helper that runs on this computer and forwards Claude Desktop to the "
"site. Nothing is exposed to the internet."
msgstr ""
"यह साइट आपके कंप्यूटर पर चलती है, इसलिए क्लाउड कनेक्टर इस तक नहीं पहुंच सकता। इसके बजाय "
"Claude Desktop को <strong>लोकल ब्रिज</strong> से कनेक्ट करें: एक छोटा हेल्पर जो इसी "
"कंप्यूटर पर चलता है और Claude Desktop को साइट तक पहुंचाता है। कुछ भी इंटरनेट पर उजागर "
"नहीं होता।"

#: admin/class-mcp-admin.php:916
msgid "Add the bridge to Claude Desktop"
msgstr "Claude Desktop में ब्रिज जोड़ें"

#: admin/class-mcp-admin.php:919
msgid ""
"Add this to <code>claude_desktop_config.json</code> (create the file if it "
"does not exist), then fully quit and restart the Claude app:"
msgstr ""
"इसे <code>claude_desktop_config.json</code> में जोड़ें (फ़ाइल न हो तो बनाएं), फिर "
"Claude ऐप को पूरी तरह बंद करके दोबारा शुरू करें:"

#: admin/class-mcp-admin.php:923 admin/class-mcp-admin.php:971
#: admin/class-mcp-admin.php:1056
msgid "Copy setup command"
msgstr "सेटअप कमांड कॉपी करें"

#: admin/class-mcp-admin.php:924
msgid ""
"macOS: <code>~/Library/Application Support/Claude/"
"claude_desktop_config.json</code> — Windows: <code>%APPDATA%"
"\\Claude\\claude_desktop_config.json</code>"
msgstr ""
"macOS: <code>~/Library/Application Support/Claude/"
"claude_desktop_config.json</code> — Windows: <code>%APPDATA%"
"\\Claude\\claude_desktop_config.json</code>"

#: admin/class-mcp-admin.php:925
msgid ""
"Requires Node.js on this computer — the bridge is the standard open-source "
"<code>mcp-remote</code> package, started on demand via <code>npx</code>. It "
"connects only from your computer to this site."
msgstr ""
"इस कंप्यूटर पर Node.js आवश्यक है — ब्रिज मानक ओपन-सोर्स <code>mcp-remote</code> पैकेज "
"है, जो ज़रूरत पड़ने पर <code>npx</code> से शुरू होता है। यह केवल आपके कंप्यूटर से इस साइट "
"तक कनेक्ट होता है।"

#: admin/class-mcp-admin.php:926
msgid ""
"Your API key is stored in plain text in that file, so prefer a <strong>read-"
"only</strong> key unless this connection needs to make changes — and revoke "
"it here when you no longer use it."
msgstr ""
"आपकी API कुंजी उस फ़ाइल में सादे टेक्स्ट में संग्रहीत होती है, इसलिए जब तक इस कनेक्शन को "
"बदलाव करने की ज़रूरत न हो, <strong>केवल-पढ़ने</strong> वाली कुंजी चुनें — और उपयोग बंद "
"करने पर उसे यहीं निरस्त करें।"

#: admin/class-mcp-admin.php:937 admin/class-mcp-admin.php:1099
msgid "Check it worked"
msgstr "जाँचें कि यह काम कर गया"

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:942
#, php-format
msgid ""
"Open a new chat in Claude Desktop and click the tools icon — <code>%s</code> "
"should be listed. The first start can take a moment while the bridge "
"downloads."
msgstr ""
"Claude Desktop में नई चैट खोलें और टूल आइकन पर क्लिक करें — सूची में <code>%s</code> "
"दिखना चाहिए। पहली बार शुरू होने में थोड़ा समय लग सकता है, क्योंकि ब्रिज डाउनलोड होता है।"

#: admin/class-mcp-admin.php:965
msgid "Getting a certificate error?"
msgstr "प्रमाणपत्र त्रुटि आ रही है?"

#: admin/class-mcp-admin.php:967
msgid ""
"Local sites usually use a self-signed certificate that AI tools reject. "
"Since this site runs on this same computer, you can use the plain "
"<code>http://</code> address instead — the connection never leaves your "
"machine. Avoid the <code>NODE_TLS_REJECT_UNAUTHORIZED=0</code> workaround "
"you may see online: it disables certificate checks for everything that tool "
"connects to."
msgstr ""
"लोकल साइटें आमतौर पर स्व-हस्ताक्षरित प्रमाणपत्र उपयोग करती हैं, जिन्हें AI टूल अस्वीकार कर "
"देते हैं। चूंकि यह साइट इसी कंप्यूटर पर चलती है, आप सादा <code>http://</code> पता "
"उपयोग कर सकते हैं — कनेक्शन कभी आपकी मशीन से बाहर नहीं जाता। इंटरनेट पर दिखने वाले "
"<code>NODE_TLS_REJECT_UNAUTHORIZED=0</code> उपाय से बचें: यह उस टूल के हर कनेक्शन के "
"लिए प्रमाणपत्र जांच बंद कर देता है।"

