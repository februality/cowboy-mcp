msgstr "एडमिनिस्ट्रेटर बनाना और पासवर्ड रीसेट करना"

#: admin/class-mcp-admin-settings.php:120
msgid "Potential risks"
msgstr "संभावित जोखिम"

#: admin/class-mcp-admin-settings.php:122
