msgstr "इसके बजाय कॉन्फ़िग फ़ाइल संपादित करें"

#: admin/class-mcp-admin-connections.php:682
msgid ""
"Add this to <code>claude_desktop_config.json</code>, then fully quit and "
"reopen the Claude app."
msgstr ""
"इसे <code>claude_desktop_config.json</code> में जोड़ें, फिर Claude ऐप को पूरी तरह "
"बंद करके दोबारा खोलें।"

#: admin/class-mcp-admin-connections.php:685
msgid ""
"macOS: <code>~/Library/Application Support/Claude/"
"claude_desktop_config.json</code>"
msgstr ""
"macOS: <code>~/Library/Application Support/Claude/"
"claude_desktop_config.json</code>"

