msgstr "Endpoint"

#: admin/class-mcp-admin-connections.php:969
msgid "Server Transport"
msgstr "Server Transport"

#: admin/class-mcp-admin-connections.php:970
msgid ""
"<strong>Bearer Auth</strong> — create a Bearer Auth credential and paste the "
"API key below."
msgstr ""
"<strong>Bearer Auth</strong> — créez un identifiant Bearer Auth et collez la "
"clé API ci-dessous."

#: admin/class-mcp-admin-connections.php:970
msgid "Authentication"
msgstr "Authentication"

#: admin/class-mcp-admin-connections.php:973
