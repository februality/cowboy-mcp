#: admin/class-mcp-admin.php:163
msgid "API key created. Copy it now — it will only be shown once."
msgstr ""
"Clé API créée. Copiez-la maintenant — elle ne sera affichée qu'une seule "
"fois."

#: admin/class-mcp-admin.php:170
msgid "API key revoked."
msgstr "Clé API révoquée."

#: admin/class-mcp-admin.php:178
msgid "Connection revoked."
msgstr "Connexion révoquée."

#: admin/class-mcp-admin.php:184
msgid "Desktop Connector enabled."
msgstr "Desktop Connector activé."

#: admin/class-mcp-admin.php:207
