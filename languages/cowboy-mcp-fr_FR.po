#: admin/class-mcp-admin.php:783
#, php-format
msgid ""
"Open a new Claude Code session and run <code>/mcp</code> — <code>%s</code> "
"should be listed as connected."
msgstr ""
"Ouvrez une nouvelle session Claude Code et exécutez <code>/mcp</code> — "
"<code>%s</code> devrait apparaître comme connecté."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:785
#, php-format
msgid ""
"Run <code>codex mcp list</code> — <code>%s</code> should appear in the list."
msgstr ""
"Exécutez <code>codex mcp list</code> — <code>%s</code> devrait apparaître "
"dans la liste."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:787
#, php-format
msgid ""
"Restart Opencode and ask it to list its MCP servers — <code>%s</code> should "
"be available."
msgstr ""
"Redémarrez Opencode et demandez-lui de lister ses serveurs MCP — <code>%s</"
"code> devrait être disponible."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:789
#, php-format
msgid ""
"Open <code>Cursor Settings → MCP</code> — <code>%s</code> should appear with "
"a green status dot."
msgstr ""
"Ouvrez <code>Cursor Settings → MCP</code> — <code>%s</code> devrait "
"apparaître avec un indicateur d'état vert."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:791
#, php-format
msgid ""
"Run <code>gemini mcp list</code> — <code>%s</code> should show as connected."
msgstr ""
"Exécutez <code>gemini mcp list</code> — <code>%s</code> devrait s'afficher "
"comme connecté."

