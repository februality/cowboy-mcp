#: admin/class-mcp-admin.php:30 admin/class-mcp-admin.php:31
#: admin/class-mcp-admin.php:487
msgid "Cowboy MCP"
msgstr "Cowboy MCP"

#: admin/class-mcp-admin.php:90
msgid "Cowboy MCP is active!"
msgstr "Cowboy MCP est activé !"

#: admin/class-mcp-admin.php:91
msgid "Connect Claude, Cursor, or any MCP client — it takes about a minute."
msgstr ""
"Connectez Claude, Cursor ou n'importe quel client MCP — cela prend environ "
"une minute."

#: admin/class-mcp-admin.php:92
msgid "Connect your AI"
msgstr "Connecter votre IA"

#: admin/class-mcp-admin.php:245 admin/class-mcp-admin.php:265
#: admin/class-mcp-admin.php:287
msgid "Select an access level before saving."
msgstr "Sélectionnez un niveau d'accès avant d'enregistrer."

#: admin/class-mcp-admin.php:249
msgid "API key created. Copy it now — it will only be shown once."
msgstr ""
"Clé API créée. Copiez-la maintenant — elle ne sera affichée qu'une seule "
"fois."

#: admin/class-mcp-admin.php:257
msgid "API key revoked."
msgstr "Clé API révoquée."

#: admin/class-mcp-admin.php:267
msgid "Key scope updated. It takes effect on the key's next request."
msgstr ""
"La portée de la clé a été mise à jour. Elle prendra effet lors de la "
"prochaine requête de la clé."

#: admin/class-mcp-admin.php:269
msgid "Could not update key scope."
msgstr "Impossible de mettre à jour la portée de la clé."

#: admin/class-mcp-admin.php:278
msgid "Connection revoked."
msgstr "Connexion révoquée."

#: admin/class-mcp-admin.php:289
msgid ""
"Connection scope updated. It takes effect on the connection's next request."
msgstr ""
"La portée de la connexion a été mise à jour. Elle prendra effet lors de la "
"prochaine requête de la connexion."

#: admin/class-mcp-admin.php:291
msgid "Could not update connection scope."
msgstr "Impossible de mettre à jour la portée de la connexion."

#: admin/class-mcp-admin.php:297
msgid "Desktop Connector enabled."
msgstr "Desktop Connector activé."

#: admin/class-mcp-admin.php:331
msgid "Settings saved."
msgstr "Réglages enregistrés."

#: admin/class-mcp-admin.php:338
msgid "Audit log cleared."
msgstr "Journal d'audit vidé."

#. translators: 1: change ID number, 2: optional note appended after the message
#: admin/class-mcp-admin.php:356
#, php-format
msgid "Change #%1$d undone.%2$s"
msgstr "Modification n°%1$d annulée.%2$s"

#. translators: 1: number of entries undone, 2: total number of entries in the batch
#: admin/class-mcp-admin.php:371
#, php-format
msgid "%1$d of %2$d batch entries undone."
msgstr "%1$d entrée(s) du lot sur %2$d annulée(s)."

#. translators: 1: checkpoint ID number, 2: human-readable file size
#: admin/class-mcp-admin.php:387
#, php-format
msgid "Checkpoint #%1$d created (%2$s)."
msgstr "Point de contrôle n°%1$d créé (%2$s)."

#. translators: 1: restored checkpoint ID number, 2: pre-restore safety checkpoint ID number
#: admin/class-mcp-admin.php:399
#, php-format
msgid ""
"Database restored from checkpoint #%1$d. Pre-restore safety checkpoint: "
"#%2$d."
msgstr ""
"Base de données restaurée à partir du point de contrôle n°%1$d. Point de "
"contrôle de sécurité avant restauration : n°%2$d."

#: admin/class-mcp-admin.php:410
msgid "Checkpoint deleted."
msgstr "Point de contrôle supprimé."

#: admin/class-mcp-admin.php:493
msgid ""
"Connect AI agents like <strong>Claude</strong>, <strong>ChatGPT</strong>, or "
"<strong>Codex</strong> to this WordPress site over the Model Context "
"Protocol."
msgstr ""
"Connectez des agents IA comme <strong>Claude</strong>, <strong>ChatGPT</"
"strong> ou <strong>Codex</strong> à ce site WordPress via le Model Context "
"Protocol."

#: admin/class-mcp-admin.php:499
msgid "Connection"
msgstr "Connexion"

#: admin/class-mcp-admin.php:500
msgid "Settings"
msgstr "Réglages"

#: admin/class-mcp-admin.php:501
msgid "Activity"
msgstr "Activité"

#: admin/class-mcp-admin.php:502
msgid "Logs"
msgstr "Journaux"

#: admin/class-mcp-admin.php:503
msgid "About"
msgstr "À propos"

#. translators: %s: Model Context Protocol website URL.
#: admin/class-mcp-admin.php:530
#, php-format
msgid ""
"<strong>Cowboy MCP</strong> turns this WordPress site into a <a href=\"%s\" "
"target=\"_blank\" rel=\"noopener noreferrer\">Model Context Protocol</a> "
"server, so AI coding agents like Claude Code, Codex, and Opencode can read, "
"edit, and manage the whole site through a single authenticated endpoint."
msgstr ""
"<strong>Cowboy MCP</strong> transforme ce site WordPress en serveur <a "
"href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Model Context "
"Protocol</a>, afin que des agents de programmation IA comme Claude Code, "
"Codex et Opencode puissent lire, modifier et gérer l'ensemble du site via un "
"unique point de terminaison authentifié."

#: admin/class-mcp-admin.php:544
msgid "Website"
msgstr "Site web"

#: admin/class-mcp-admin.php:545
msgid "Project home, guides, and news."
msgstr "Page d'accueil du projet, guides et actualités."

#: admin/class-mcp-admin.php:551
msgid "GitHub"
msgstr "GitHub"

#: admin/class-mcp-admin.php:552
msgid "Source, issues & releases."
msgstr "Code source, tickets et versions."

#: admin/class-mcp-admin.php:558
msgid "Get help"
msgstr "Obtenir de l'aide"

#: admin/class-mcp-admin.php:559
msgid ""
"Ask in the WordPress.org support forum. Paste your Connection Doctor report "
"for a fast answer."
msgstr ""
"Posez votre question sur le forum de support de WordPress.org. Collez votre "
"rapport du Diagnostic de connexion pour obtenir une réponse plus rapide."

#: admin/class-mcp-admin.php:565 admin/class-mcp-feedback.php:192
msgid "Leave a review"
msgstr "Laisser un avis"

#: admin/class-mcp-admin.php:566
msgid ""
"Enjoying Cowboy MCP? A review on WordPress.org helps other site owners find "
"it."
msgstr ""
"Vous appréciez Cowboy MCP ? Un avis sur WordPress.org aide d'autres "
"propriétaires de sites à le découvrir."

#. translators: %s: plugin version number
#: admin/class-mcp-admin.php:574
#, php-format
msgid "v%s · GPL-2.0"
msgstr "v%s · GPL-2.0"

#: admin/class-mcp-admin.php:596
msgid "Which app do you want to connect?"
msgstr "Quelle application souhaitez-vous connecter ?"

#: admin/class-mcp-admin.php:597
msgid ""
"Pick your AI app or coding tool from the list to see step-by-step setup "
"instructions."
msgstr ""
"Sélectionnez votre application IA ou votre outil de programmation dans la "
"liste pour afficher les instructions de configuration étape par étape."

#: admin/class-mcp-admin.php:623
msgid "Connection Doctor"
msgstr "Diagnostic de connexion"

#: admin/class-mcp-admin.php:624
msgid ""
"Test whether AI clients can reach this site and get a copy-pasteable "
"diagnosis for anything broken."
msgstr ""
"Vérifiez si les clients IA peuvent atteindre ce site et obtenez un "
"diagnostic copiable-collable de tout problème."

#: admin/class-mcp-admin.php:625
msgid "Run checks"
msgstr "Lancer les vérifications"

#: admin/class-mcp-admin.php:626
msgid "Copy report"
msgstr "Copier le rapport"

#: admin/class-mcp-admin.php:627
msgid "Get help on WordPress.org"
msgstr "Obtenir de l'aide sur WordPress.org"

#: admin/class-mcp-admin.php:638
msgid "No terminal needed"
msgstr "Aucun terminal requis"

#: admin/class-mcp-admin.php:639
msgid "Terminal & IDE tools"
msgstr "Outils terminal et IDE"

#: admin/class-mcp-admin.php:643
msgid "AI clients"
msgstr "Clients IA"

#: admin/class-mcp-admin.php:666
msgid "Needs public URL"
msgstr "URL publique requise"

#: admin/class-mcp-admin.php:668
msgid "Works locally"
msgstr "Fonctionne en local"

#: admin/class-mcp-admin.php:688
msgid ""
"Site actually on a public HTTPS address? Use the cloud connector instead"
msgstr ""
"Votre site est en réalité sur une adresse HTTPS publique ? Utilisez plutôt "
"le connecteur cloud"

#: admin/class-mcp-admin.php:721 admin/class-mcp-admin.php:828
msgid ""
"<strong>Heads up:</strong> this site does not appear to be on a public HTTPS "
"address. ChatGPT connects from OpenAI's cloud, so it cannot reach local, "
"private, or non-HTTPS sites. A terminal tool works here instead, or connect "
"through a tunnel/staging URL."
msgstr ""
"<strong>Attention :</strong> ce site ne semble pas accessible à une adresse "
"HTTPS publique. ChatGPT se connecte depuis le cloud d'OpenAI et ne peut donc "
"pas atteindre les sites locaux, privés ou sans HTTPS. Un outil en terminal "
"fonctionne ici à la place, ou connectez-vous via un tunnel ou une URL de "
"préproduction."

#: admin/class-mcp-admin.php:722 admin/class-mcp-admin.php:829
msgid ""
"<strong>Heads up:</strong> this site does not appear to be on a public HTTPS "
"address. The Claude apps connect from Anthropic's cloud, so they cannot "
"reach local, private, or non-HTTPS sites. A terminal tool works here "
"instead, or connect through a tunnel/staging URL."
msgstr ""
"<strong>Attention :</strong> ce site ne semble pas accessible à une adresse "
"HTTPS publique. Les applications Claude se connectent depuis le cloud "
"d'Anthropic et ne peuvent donc pas atteindre les sites locaux, privés ou "
"sans HTTPS. Un outil en terminal fonctionne ici à la place, ou connectez-"
"vous via un tunnel ou une URL de préproduction."

#: admin/class-mcp-admin.php:724
msgid ""
"This opens a secure sign-in so ChatGPT can connect without a terminal. No "
"access is granted until you approve it in your browser."
msgstr ""
"Cela ouvre une connexion sécurisée pour que ChatGPT puisse se connecter sans "
"terminal. Aucun accès n'est accordé tant que vous ne l'avez pas approuvé "
"dans votre navigateur."

#: admin/class-mcp-admin.php:725
msgid ""
"This opens a secure sign-in so the Claude apps can connect without a "
"terminal. No access is granted until you approve it in your browser."
msgstr ""
"Cela ouvre une connexion sécurisée pour que les applications Claude puissent "
"se connecter sans terminal. Aucun accès n'est accordé tant que vous ne "
"l'avez pas approuvé dans votre navigateur."

#: admin/class-mcp-admin.php:727
msgid "You'll paste this into ChatGPT in the next step."
msgstr "Vous collerez ceci dans ChatGPT à l'étape suivante."

#: admin/class-mcp-admin.php:728
msgid "You'll paste this into Claude in the next step."
msgstr "Vous collerez ceci dans Claude à l'étape suivante."

#: admin/class-mcp-admin.php:730
msgid "Add it in ChatGPT"
msgstr "Ajoutez-le dans ChatGPT"

#: admin/class-mcp-admin.php:731
msgid "Add it in the Claude app"
msgstr "Ajoutez-le dans l'application Claude"

#: admin/class-mcp-admin.php:732
msgid "Add it on claude.ai"
msgstr "Ajoutez-le sur claude.ai"

#: admin/class-mcp-admin.php:735
msgid ""
"ChatGPT opens a sign-in page on <strong>your site</strong>. Review what it "
"is asking for and click <strong>Approve</strong>. That is it — you are "
"connected."
msgstr ""
"ChatGPT ouvre une page de connexion sur <strong>votre site</strong>. "
"Vérifiez ce qui est demandé et cliquez sur <strong>Approuver</strong>. C'est "
"tout — vous êtes connecté."

#: admin/class-mcp-admin.php:736
msgid ""
"Claude opens a sign-in page on <strong>your site</strong>. Review what it is "
"asking for and click <strong>Approve</strong>. That is it — you are "
"connected."
msgstr ""
"Claude ouvre une page de connexion sur <strong>votre site</strong>. Vérifiez "
"ce qui est demandé et cliquez sur <strong>Approuver</strong>. C'est tout — "
"vous êtes connecté."

#: admin/class-mcp-admin.php:738
msgid ""
"Custom connectors require a paid ChatGPT plan with <strong>Developer mode</"
"strong> (beta) enabled."
msgstr ""
"Les connecteurs personnalisés nécessitent un forfait ChatGPT payant avec le "
"<strong>Developer mode</strong> (bêta) activé."

#: admin/class-mcp-admin.php:739
msgid ""
"Custom connectors require a Claude <strong>Pro, Max, Team, or Enterprise</"
"strong> plan."
msgstr ""
"Les connecteurs personnalisés nécessitent un forfait Claude <strong>Pro, "
"Max, Team ou Enterprise</strong>."

#: admin/class-mcp-admin.php:755
msgid "Turn on the Desktop Connector"
msgstr "Activez le Desktop Connector"

#: admin/class-mcp-admin.php:761
msgid "Enable Desktop Connector"
msgstr "Activer le Desktop Connector"

#: admin/class-mcp-admin.php:772
msgid "Copy your connection link"
msgstr "Copiez votre lien de connexion"

#: admin/class-mcp-admin.php:779 admin/class-mcp-admin.php:871
#: admin/class-mcp-admin.php:919 admin/class-mcp-admin.php:962
#: admin/class-mcp-admin.php:1004
msgid "Copy"
msgstr "Copier"

#: admin/class-mcp-admin.php:779
msgid "Copy connector URL"
msgstr "Copier l'URL du connecteur"

#: admin/class-mcp-admin.php:791
msgid ""
"Go to <code>chatgpt.com</code> (or open the ChatGPT desktop app) and sign in."
msgstr ""
"Rendez-vous sur <code>chatgpt.com</code> (ou ouvrez l'application de bureau "
"ChatGPT) et connectez-vous."

#: admin/class-mcp-admin.php:792
msgid ""
"Go to <code>Settings → Connectors → Advanced</code> and turn on "
"<strong>Developer mode</strong> (one-time)."
msgstr ""
"Allez dans <code>Settings → Connectors → Advanced</code> et activez le "
"<strong>Developer mode</strong> (une seule fois)."

#: admin/class-mcp-admin.php:793
msgid "Back in <code>Connectors</code>, click <strong>Create</strong>."
msgstr ""
"De retour dans <code>Connectors</code>, cliquez sur <strong>Create</strong>."

#: admin/class-mcp-admin.php:794
msgid ""
"Paste the link from step 1 as the <strong>MCP server URL</strong>, set "
"Authentication to <strong>OAuth</strong>, and click <strong>Create</strong>."
msgstr ""
"Collez le lien de l'étape 1 dans le champ <strong>MCP server URL</strong>, "
"réglez l'authentification sur <strong>OAuth</strong>, puis cliquez sur "
"<strong>Create</strong>."

#: admin/class-mcp-admin.php:797
msgid "Open the <strong>Claude</strong> desktop app and sign in."
msgstr ""
"Ouvrez l'application de bureau <strong>Claude</strong> et connectez-vous."

#: admin/class-mcp-admin.php:799
msgid "Go to <code>claude.ai</code> in your browser and sign in."
msgstr ""
"Rendez-vous sur <code>claude.ai</code> dans votre navigateur et connectez-"
"vous."

#: admin/class-mcp-admin.php:801
msgid "Go to <code>Customize → Connections</code>."
msgstr "Allez dans <code>Customize → Connections</code>."

#: admin/class-mcp-admin.php:802
msgid "Click <strong>Add custom connector</strong>."
msgstr "Cliquez sur <strong>Add custom connector</strong>."

#: admin/class-mcp-admin.php:803
msgid "Paste the link from step 1 and click <strong>Add</strong>."
msgstr "Collez le lien de l'étape 1 et cliquez sur <strong>Add</strong>."

#: admin/class-mcp-admin.php:812
msgid "Approve access"
msgstr "Approuvez l'accès"

#: admin/class-mcp-admin.php:833
msgid "What works on a local site:"
msgstr "Ce qui fonctionne sur un site local :"

#: admin/class-mcp-admin.php:835
msgid ""
"<strong>Terminal tools</strong> (Claude Code, Codex, Cursor, Gemini CLI) — "
"connect right now, no public URL needed. Pick one in the sidebar."
msgstr ""
"<strong>Outils en terminal</strong> (Claude Code, Codex, Cursor, Gemini CLI) "
"— se connectent immédiatement, sans URL publique. Choisissez-en un dans la "
"barre latérale."

#: admin/class-mcp-admin.php:836
msgid ""
"<strong>Claude Desktop</strong> — connects through a local bridge that runs "
"on this computer. Pick it in the sidebar for instructions."
msgstr ""
"<strong>Claude Desktop</strong> — se connecte via un pont local exécuté sur "
"cet ordinateur. Sélectionnez-le dans la barre latérale pour les instructions."

#: admin/class-mcp-admin.php:837
msgid ""
"<strong>claude.ai and ChatGPT</strong> — cloud-only: they need a public "
"HTTPS address. A tunnel (e.g. ngrok or Cloudflare Tunnel) works temporarily, "
"but it exposes your entire dev site to the internet while it runs, and the "
"WordPress Site Address must be set to the tunnel URL for the sign-in to work."
msgstr ""
"<strong>claude.ai et ChatGPT</strong> — cloud uniquement : ils exigent une "
"adresse HTTPS publique. Un tunnel (ngrok ou Cloudflare Tunnel, par exemple) "
"fonctionne temporairement, mais il expose tout votre site de développement à "
"Internet tant qu'il tourne, et l'adresse du site WordPress doit être "
"remplacée par l'URL du tunnel pour que la connexion fonctionne."

#: admin/class-mcp-admin.php:856
msgid ""
"This site runs on your computer, so the cloud connector cannot reach it. "
"Connect Claude Desktop through a <strong>local bridge</strong> instead: a "
"small helper that runs on this computer and forwards Claude Desktop to the "
"site. Nothing is exposed to the internet."
msgstr ""
"Ce site s'exécute sur votre ordinateur, le connecteur cloud ne peut donc pas "
"l'atteindre. Connectez plutôt Claude Desktop via un <strong>pont local</"
"strong> : un petit utilitaire qui tourne sur cet ordinateur et relaie Claude "
"Desktop vers le site. Rien n'est exposé à Internet."

#: admin/class-mcp-admin.php:864
msgid "Add the bridge to Claude Desktop"
msgstr "Ajouter le pont à Claude Desktop"

#: admin/class-mcp-admin.php:867
msgid ""
"Add this to <code>claude_desktop_config.json</code> (create the file if it "
"does not exist), then fully quit and restart the Claude app:"
msgstr ""
"Ajoutez ceci dans <code>claude_desktop_config.json</code> (créez le fichier "
"s'il n'existe pas), puis quittez complètement et relancez l'application "
"Claude :"

#: admin/class-mcp-admin.php:871 admin/class-mcp-admin.php:919
#: admin/class-mcp-admin.php:1004
msgid "Copy setup command"
msgstr "Copier la commande de configuration"

#: admin/class-mcp-admin.php:872
msgid ""
"macOS: <code>~/Library/Application Support/Claude/"
"claude_desktop_config.json</code> — Windows: <code>%APPDATA%"
"\\Claude\\claude_desktop_config.json</code>"
msgstr ""
"macOS: <code>~/Library/Application Support/Claude/"
"claude_desktop_config.json</code> — Windows: <code>%APPDATA%"
"\\Claude\\claude_desktop_config.json</code>"

#: admin/class-mcp-admin.php:873
msgid ""
"Requires Node.js on this computer — the bridge is the standard open-source "
"<code>mcp-remote</code> package, started on demand via <code>npx</code>. It "
"connects only from your computer to this site."
msgstr ""
"Nécessite Node.js sur cet ordinateur — le pont est le paquet open source "
"standard <code>mcp-remote</code>, lancé à la demande via <code>npx</code>. "
"Il ne se connecte que depuis votre ordinateur vers ce site."

#: admin/class-mcp-admin.php:874
msgid ""
"Your API key is stored in plain text in that file, so prefer a <strong>read-"
"only</strong> key unless this connection needs to make changes — and revoke "
"it here when you no longer use it."
msgstr ""
"Votre clé d'API est stockée en clair dans ce fichier : privilégiez une clé "
"en <strong>lecture seule</strong> sauf si cette connexion doit effectuer des "
"modifications — et révoquez-la ici quand vous ne l'utilisez plus."

#: admin/class-mcp-admin.php:885 admin/class-mcp-admin.php:1047
msgid "Check it worked"
msgstr "Vérifiez que tout fonctionne"

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:890
#, php-format
msgid ""
"Open a new chat in Claude Desktop and click the tools icon — <code>%s</code> "
"should be listed. The first start can take a moment while the bridge "
"downloads."
msgstr ""
"Ouvrez une nouvelle discussion dans Claude Desktop et cliquez sur l'icône "
"des outils — <code>%s</code> devrait apparaître dans la liste. Le premier "
"démarrage peut prendre un moment, le temps que le pont se télécharge."

#: admin/class-mcp-admin.php:913
msgid "Getting a certificate error?"
msgstr "Une erreur de certificat ?"

#: admin/class-mcp-admin.php:915
msgid ""
"Local sites usually use a self-signed certificate that AI tools reject. "
"Since this site runs on this same computer, you can use the plain "
"<code>http://</code> address instead — the connection never leaves your "
"machine. Avoid the <code>NODE_TLS_REJECT_UNAUTHORIZED=0</code> workaround "
"you may see online: it disables certificate checks for everything that tool "
"connects to."
msgstr ""
"Les sites locaux utilisent généralement un certificat auto-signé que les "
"outils d'IA refusent. Comme ce site s'exécute sur ce même ordinateur, vous "
"pouvez utiliser l'adresse <code>http://</code> simple — la connexion ne "
"quitte jamais votre machine. Évitez le contournement "
"<code>NODE_TLS_REJECT_UNAUTHORIZED=0</code> que l'on trouve en ligne : il "
"désactive la vérification des certificats pour tout ce à quoi l'outil se "
"connecte."

#: admin/class-mcp-admin.php:954
msgid "Create an API key"
msgstr "Créez une clé API"

#: admin/class-mcp-admin.php:958
msgid ""
"<strong>Copy your key now</strong> — for security it will not be shown again."
msgstr ""
"<strong>Copiez votre clé maintenant</strong> — pour des raisons de sécurité, "
"elle ne sera plus affichée."

#: admin/class-mcp-admin.php:962
msgid "Copy API key"
msgstr "Copier la clé API"

#: admin/class-mcp-admin.php:963
msgid "I've saved my key"
msgstr "J'ai enregistré ma clé"

#: admin/class-mcp-admin.php:965
msgid "Give it a name so you can recognize it later, then generate."
msgstr "Donnez-lui un nom pour la reconnaître plus tard, puis générez-la."

#. translators: %s: client name, e.g. "Claude Code"
#: admin/class-mcp-admin.php:970
#, php-format
msgid "e.g. %s on my laptop"
msgstr "p. ex. %s sur mon ordinateur portable"

#: admin/class-mcp-admin.php:973
msgid "Generate API key"
msgstr "Générer une clé API"

#: admin/class-mcp-admin.php:973
msgid "Generate another key"
msgstr "Générer une autre clé"

#: admin/class-mcp-admin.php:987
msgid "Run this in your terminal:"
msgstr "Exécutez ceci dans votre terminal :"

#: admin/class-mcp-admin.php:988
msgid "Run these in your terminal:"
msgstr "Exécutez ces commandes dans votre terminal :"

#: admin/class-mcp-admin.php:989
msgid "Add this to your <code>opencode.json</code>:"
msgstr "Ajoutez ceci à votre <code>opencode.json</code> :"

#: admin/class-mcp-admin.php:990
msgid ""
"Add this to <code>~/.cursor/mcp.json</code> (create the file if it does not "
"exist), then reload Cursor:"
msgstr ""
"Ajoutez ceci à <code>~/.cursor/mcp.json</code> (créez le fichier s'il "
"n'existe pas), puis rechargez Cursor :"

#: admin/class-mcp-admin.php:997
msgid "Add the server to your tool"
msgstr "Ajoutez le serveur à votre outil"

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:1032
#, php-format
msgid ""
"Open a new Claude Code session and run <code>/mcp</code> — <code>%s</code> "
"should be listed as connected."
msgstr ""
