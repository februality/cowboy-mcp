msgstr "Cowboy MCP"

#: admin/class-mcp-admin.php:159
msgid "API key created. Copy it now — it will only be shown once."
msgstr "API キーを作成しました。今すぐコピーしてください。一度しか表示されません。"

#: admin/class-mcp-admin.php:166
msgid "API key revoked."
msgstr "API キーを無効化しました。"

#: admin/class-mcp-admin.php:174
msgid "Connection revoked."
msgstr "接続を無効化しました。"

#: admin/class-mcp-admin.php:180
msgid "Desktop Connector enabled."
msgstr "Desktop Connector を有効化しました。"

#: admin/class-mcp-admin.php:203
msgid "Settings saved."
msgstr "設定を保存しました。"

#: admin/class-mcp-admin.php:210
msgid "Audit log cleared."
msgstr "監査ログを消去しました。"

#. translators: 1: change ID number, 2: optional note appended after the message
#: admin/class-mcp-admin.php:228
#, php-format
msgid "Change #%1$d undone.%2$s"
msgstr "変更 #%1$d を取り消しました。%2$s"

