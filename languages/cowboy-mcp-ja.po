msgstr "ChatGPT を開く"

#: admin/class-mcp-admin-connections.php:407
#: admin/class-mcp-admin-connections.php:556
#: admin/class-mcp-admin-connections.php:575
#: admin/class-mcp-admin-connections.php:695
#: admin/class-mcp-admin-connections.php:1710
