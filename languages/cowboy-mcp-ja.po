msgstr "%2$d 件中 %1$d 件のバッチエントリを取り消しました。"

#. translators: 1: checkpoint ID number, 2: human-readable file size
#: admin/class-mcp-admin.php:259
#, php-format
msgid "Checkpoint #%1$d created (%2$s)."
msgstr "チェックポイント #%1$d を作成しました（%2$s）。"

#. translators: 1: restored checkpoint ID number, 2: pre-restore safety checkpoint ID number
#: admin/class-mcp-admin.php:271
#, php-format
msgid "Database restored from checkpoint #%1$d. Pre-restore safety checkpoint: #%2$d."
msgstr "チェックポイント #%1$d からデータベースを復元しました。復元前の安全チェックポイント: #%2$d。"

#: admin/class-mcp-admin.php:282
msgid "Checkpoint deleted."
msgstr "チェックポイントを削除しました。"

#: admin/class-mcp-admin.php:338
msgid "Connect AI agents like <strong>Claude</strong>, <strong>ChatGPT</strong>, or <strong>Codex</strong> to this WordPress site over the Model Context Protocol."
msgstr "<strong>Claude</strong>、<strong>ChatGPT</strong>、<strong>Codex</strong> などの AI エージェントを、Model Context Protocol 経由でこの WordPress サイトに接続します。"

#: admin/class-mcp-admin.php:344
msgid "Connection"
msgstr "接続"

#: admin/class-mcp-admin.php:345
msgid "Settings"
msgstr "設定"

#: admin/class-mcp-admin.php:346
msgid "Activity"
msgstr "アクティビティ"

#: admin/class-mcp-admin.php:347
msgid "Logs"
msgstr "ログ"

#: admin/class-mcp-admin.php:348
msgid "About"
msgstr "概要"

#. translators: %s: Model Context Protocol website URL.
#: admin/class-mcp-admin.php:375
#, php-format
msgid "<strong>Cowboy MCP</strong> turns this WordPress site into a <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Model Context Protocol</a> server, so AI coding agents like Claude Code, Codex, and Opencode can read, edit, and manage the whole site through a single authenticated endpoint."
msgstr "<strong>Cowboy MCP</strong> はこの WordPress サイトを <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Model Context Protocol</a> サーバーに変えます。これにより、Claude Code、Codex、Opencode などの AI コーディングエージェントが、単一の認証済みエンドポイントを通じてサイト全体を読み取り、編集し、管理できます。"

#: admin/class-mcp-admin.php:389
msgid "Website"
msgstr "ウェブサイト"

#: admin/class-mcp-admin.php:390
msgid "Project home, guides, and news."
msgstr "プロジェクトのホーム、ガイド、ニュース。"

#: admin/class-mcp-admin.php:396
msgid "GitHub"
msgstr "GitHub"

#: admin/class-mcp-admin.php:397
msgid "Source, issues & releases."
msgstr "ソースコード、課題、リリース。"

#. translators: %s: plugin version number
#: admin/class-mcp-admin.php:405
#, php-format
msgid "v%s · GPL-2.0"
msgstr "v%s · GPL-2.0"

#: admin/class-mcp-admin.php:426
msgid "Which app do you want to connect?"
msgstr "どのアプリを接続しますか？"

#: admin/class-mcp-admin.php:427
msgid "Pick your AI app or coding tool from the list to see step-by-step setup instructions."
msgstr "リストから AI アプリまたはコーディングツールを選択すると、手順ごとの設定方法が表示されます。"

#: admin/class-mcp-admin.php:458
msgid "No terminal needed"
msgstr "ターミナル不要"

#: admin/class-mcp-admin.php:459
msgid "Terminal & IDE tools"
msgstr "ターミナル・IDE ツール"

#: admin/class-mcp-admin.php:463
msgid "AI clients"
msgstr "AI クライアント"

#: admin/class-mcp-admin.php:508
msgid "<strong>Heads up:</strong> this site does not appear to be on a public HTTPS address. ChatGPT connects from OpenAI's cloud, so it cannot reach local, private, or non-HTTPS sites. A terminal tool works here instead, or connect through a tunnel/staging URL."
msgstr "<strong>ご注意:</strong> このサイトは公開 HTTPS アドレスにないようです。ChatGPT は OpenAI のクラウドから接続するため、ローカル・プライベート・非 HTTPS のサイトには到達できません。代わりにターミナルツールを使うか、トンネルやステージング URL を通じて接続してください。"

#: admin/class-mcp-admin.php:509
msgid "<strong>Heads up:</strong> this site does not appear to be on a public HTTPS address. The Claude apps connect from Anthropic's cloud, so they cannot reach local, private, or non-HTTPS sites. A terminal tool works here instead, or connect through a tunnel/staging URL."
msgstr "<strong>ご注意:</strong> このサイトは公開 HTTPS アドレスにないようです。Claude アプリは Anthropic のクラウドから接続するため、ローカル・プライベート・非 HTTPS のサイトには到達できません。代わりにターミナルツールを使うか、トンネルやステージング URL を通じて接続してください。"

#: admin/class-mcp-admin.php:511
msgid "This opens a secure sign-in so ChatGPT can connect without a terminal. No access is granted until you approve it in your browser."
msgstr "安全なサインインが開き、ターミナルなしで ChatGPT を接続できます。ブラウザで承認するまでアクセスは許可されません。"

#: admin/class-mcp-admin.php:512
msgid "This opens a secure sign-in so the Claude apps can connect without a terminal. No access is granted until you approve it in your browser."
msgstr "安全なサインインが開き、ターミナルなしで Claude アプリを接続できます。ブラウザで承認するまでアクセスは許可されません。"

#: admin/class-mcp-admin.php:514
msgid "You'll paste this into ChatGPT in the next step."
msgstr "次のステップでこれを ChatGPT に貼り付けます。"

#: admin/class-mcp-admin.php:515
msgid "You'll paste this into Claude in the next step."
msgstr "次のステップでこれを Claude に貼り付けます。"

#: admin/class-mcp-admin.php:517
msgid "Add it in ChatGPT"
msgstr "ChatGPT に追加"

#: admin/class-mcp-admin.php:518
msgid "Add it in the Claude app"
msgstr "Claude アプリに追加"

#: admin/class-mcp-admin.php:519
msgid "Add it on claude.ai"
msgstr "claude.ai で追加"

#: admin/class-mcp-admin.php:522
msgid "ChatGPT opens a sign-in page on <strong>your site</strong>. Review what it is asking for and click <strong>Approve</strong>. That is it — you are connected."
msgstr "ChatGPT が <strong>あなたのサイト</strong>でサインインページを開きます。要求される内容を確認し、<strong>承認</strong> をクリックしてください。これで接続完了です。"

#: admin/class-mcp-admin.php:523
msgid "Claude opens a sign-in page on <strong>your site</strong>. Review what it is asking for and click <strong>Approve</strong>. That is it — you are connected."
msgstr "Claude が <strong>あなたのサイト</strong>でサインインページを開きます。要求される内容を確認し、<strong>承認</strong> をクリックしてください。これで接続完了です。"

#: admin/class-mcp-admin.php:525
msgid "Custom connectors require a paid ChatGPT plan with <strong>Developer mode</strong> (beta) enabled."
msgstr "カスタムコネクタを使うには、<strong>Developer mode</strong>（ベータ）を有効にした有料の ChatGPT プランが必要です。"

#: admin/class-mcp-admin.php:526
msgid "Custom connectors require a Claude <strong>Pro, Max, Team, or Enterprise</strong> plan."
msgstr "カスタムコネクタを使うには、Claude の <strong>Pro、Max、Team、または Enterprise</strong> プランが必要です。"

#: admin/class-mcp-admin.php:542
msgid "Turn on the Desktop Connector"
msgstr "Desktop Connector をオンにする"

#: admin/class-mcp-admin.php:548
msgid "Enable Desktop Connector"
msgstr "Desktop Connector を有効化"

#: admin/class-mcp-admin.php:559
msgid "Copy your connection link"
msgstr "接続リンクをコピー"

#: admin/class-mcp-admin.php:566
msgid "Copy connector URL"
msgstr "コネクタ URL をコピー"

#: admin/class-mcp-admin.php:566 admin/class-mcp-admin.php:641
#: admin/class-mcp-admin.php:722
msgid "Copy"
msgstr "コピー"

#: admin/class-mcp-admin.php:578
msgid "Go to <code>chatgpt.com</code> (or open the ChatGPT desktop app) and sign in."
msgstr "<code>chatgpt.com</code> にアクセス（または ChatGPT デスクトップアプリを開く）してサインインします。"

#: admin/class-mcp-admin.php:579
msgid "Go to <code>Settings → Connectors → Advanced</code> and turn on <strong>Developer mode</strong> (one-time)."
msgstr "<code>Settings → Connectors → Advanced</code> に移動し、<strong>Developer mode</strong> をオンにします（初回のみ）。"

#: admin/class-mcp-admin.php:580
msgid "Back in <code>Connectors</code>, click <strong>Create</strong>."
msgstr "<code>Connectors</code> に戻り、<strong>Create</strong> をクリックします。"

#: admin/class-mcp-admin.php:581
msgid "Paste the link from step 1 as the <strong>MCP server URL</strong>, set Authentication to <strong>OAuth</strong>, and click <strong>Create</strong>."
msgstr "ステップ 1 のリンクを <strong>MCP server URL</strong> として貼り付け、Authentication を <strong>OAuth</strong> に設定し、<strong>Create</strong> をクリックします。"

#: admin/class-mcp-admin.php:584
msgid "Open the <strong>Claude</strong> desktop app and sign in."
msgstr "<strong>Claude</strong> デスクトップアプリを開いてサインインします。"

#: admin/class-mcp-admin.php:586
msgid "Go to <code>claude.ai</code> in your browser and sign in."
msgstr "ブラウザで <code>claude.ai</code> にアクセスしてサインインします。"

#: admin/class-mcp-admin.php:588
msgid "Go to <code>Customize → Connections</code>."
msgstr "<code>Customize → Connections</code> に移動します。"

#: admin/class-mcp-admin.php:589
msgid "Click <strong>Add custom connector</strong>."
msgstr "<strong>Add custom connector</strong> をクリックします。"

#: admin/class-mcp-admin.php:590
msgid "Paste the link from step 1 and click <strong>Add</strong>."
msgstr "ステップ 1 のリンクを貼り付け、<strong>Add</strong> をクリックします。"

#: admin/class-mcp-admin.php:599
msgid "Approve access"
msgstr "アクセスを承認"

#: admin/class-mcp-admin.php:633
msgid "Create an API key"
msgstr "API キーを作成"

#: admin/class-mcp-admin.php:637
msgid "<strong>Copy your key now</strong> — for security it will not be shown again."
msgstr "<strong>今すぐキーをコピーしてください</strong> — セキュリティのため、二度と表示されません。"

#: admin/class-mcp-admin.php:641
msgid "Copy API key"
msgstr "API キーをコピー"

#: admin/class-mcp-admin.php:642
msgid "I've saved my key"
msgstr "キーを保存しました"

#: admin/class-mcp-admin.php:644
msgid "Give it a name so you can recognize it later, then generate."
msgstr "後で識別できるように名前を付けてから生成します。"

#. translators: %s: client name, e.g. "Claude Code"
#: admin/class-mcp-admin.php:649
#, php-format
msgid "e.g. %s on my laptop"
msgstr "例: ノートパソコンの %s"

#: admin/class-mcp-admin.php:651
msgid "Generate another key"
msgstr "別のキーを生成"

#: admin/class-mcp-admin.php:651
msgid "Generate API key"
msgstr "API キーを生成"

#: admin/class-mcp-admin.php:667
msgid "Add the server to your tool"
msgstr "サーバーをツールに追加"

#: admin/class-mcp-admin.php:672 admin/class-mcp-admin.php:716
msgid "Run this in your terminal:"
msgstr "ターミナルで次を実行します:"

#: admin/class-mcp-admin.php:678
