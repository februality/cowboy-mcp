#: admin/class-mcp-admin.php:817
msgid "Connected"
msgstr "已连接"

#: admin/class-mcp-admin.php:841
msgid "Revoke this connection? The app will lose access immediately."
msgstr "吊销此连接？该应用将立即失去访问权限。"

#: admin/class-mcp-admin.php:860
msgid "General"
msgstr "常规"

#: admin/class-mcp-admin.php:864
msgid "MCP Server"
msgstr "MCP 服务器"

#: admin/class-mcp-admin.php:868
msgid "Enabled"
msgstr "已启用"

#: admin/class-mcp-admin.php:870
msgid "When off, every MCP request is rejected."
msgstr "关闭时，所有 MCP 请求都会被拒绝。"

#: admin/class-mcp-admin.php:874
msgid "Safe Mode"
msgstr "安全模式"

#: admin/class-mcp-admin.php:878
msgid "Require confirmation for destructive operations"
msgstr "对破坏性操作要求确认"

#: admin/class-mcp-admin.php:882
msgid "Tools marked as destructive (delete, drop, WP-CLI write commands, etc.) require <code>confirm: true</code> in the request."
msgstr "标记为破坏性的工具（删除、drop、WP-CLI 写入命令等）需要在请求中包含 <code>confirm: true</code>。"

#: admin/class-mcp-admin.php:889
msgid "Desktop Connector"
msgstr "Desktop Connector"

#: admin/class-mcp-admin.php:893
msgid "Allow connecting via Claude Desktop / web (OAuth)"
msgstr "允许通过 Claude Desktop / 网页连接（OAuth）"

#: admin/class-mcp-admin.php:897
msgid "Turns on the one-click browser sign-in used by the &#8220;Claude Desktop&#8221; connection path. This exposes public OAuth discovery, registration, and token endpoints — no tokens are issued until an administrator approves in the browser. Leave off if you only connect via the terminal."
msgstr "开启 &#8220;Claude Desktop&#8221; 连接方式所使用的一键浏览器登录。这会公开 OAuth 发现、注册和令牌端点——但在管理员于浏览器中批准之前不会签发任何令牌。如果您只通过终端连接，请保持关闭。"

#: admin/class-mcp-admin.php:904
msgid "Rate Limit"
msgstr "速率限制"

#: admin/class-mcp-admin.php:907
msgid "requests per minute, per key"
msgstr "每个密钥每分钟的请求数"

#: admin/class-mcp-admin.php:911
msgid "Request Logging"
msgstr "请求日志记录"

#: admin/class-mcp-admin.php:915
msgid "Log all tool calls to <code>debug.log</code>"
msgstr "将所有工具调用记录到 <code>debug.log</code>"

#: admin/class-mcp-admin.php:924
msgid "Undo & Checkpoints"
msgstr "撤销与检查点"

#: admin/class-mcp-admin.php:928
msgid "Undo Journal"
msgstr "撤销日志"

#: admin/class-mcp-admin.php:932
msgid "Undo journal — capture before-state of every mutating tool call"
msgstr "撤销日志——记录每次修改性工具调用之前的状态"

#: admin/class-mcp-admin.php:934
msgid "Lets changes made through MCP be undone from the Activity tab. Disabling stops new entries from being captured; existing history is kept until it expires."
msgstr "允许从“活动”标签页撤销通过 MCP 所做的更改。禁用后将停止记录新条目；现有历史将保留至过期。"

#: admin/class-mcp-admin.php:938
msgid "Undo Retention"
msgstr "撤销保留期"

#: admin/class-mcp-admin.php:941
msgid "days to keep undo history"
msgstr "保留撤销历史的天数"

#: admin/class-mcp-admin.php:945
msgid "Checkpoint Limit"
msgstr "检查点上限"

#: admin/class-mcp-admin.php:948
msgid "checkpoints to keep"
msgstr "要保留的检查点数量"

#: admin/class-mcp-admin.php:952
msgid "Auto-Checkpoint"
msgstr "自动检查点"

#: admin/class-mcp-admin.php:956
msgid "Auto-checkpoint before mutating WP-CLI commands"
msgstr "在执行修改性 WP-CLI 命令前自动创建检查点"

#: admin/class-mcp-admin.php:958
msgid "Takes a full-database checkpoint before running a WP-CLI command that is not read-only, so it can be rolled back even if the command itself cannot be undone."
msgstr "在运行非只读的 WP-CLI 命令前对整个数据库创建检查点，因此即使该命令本身无法撤销，也可以回滚。"

#: admin/class-mcp-admin.php:966 admin/class-mcp-admin.php:970
msgid "Power Mode"
msgstr "强力模式"

#: admin/class-mcp-admin.php:966
msgid "advanced · off by default"
msgstr "高级 · 默认关闭"

#: admin/class-mcp-admin.php:974
msgid "Lift safety restrictions for advanced operations"
msgstr "为高级操作解除安全限制"

#: admin/class-mcp-admin.php:978
msgid "<strong>Danger:</strong> allows <code>eval</code>/<code>shell</code>, dangerous SQL, writing files anywhere, and requests to internal addresses. This grants effective <strong>remote code execution</strong> to anyone holding an API key. Only enable on a trusted, locked-down site you control. Your MCP API keys and the plugin&#8217;s own settings stay protected."
msgstr "<strong>危险：</strong>允许 <code>eval</code>/<code>shell</code>、危险的 SQL、向任意位置写入文件以及向内部地址发起请求。这实际上会向任何持有 API 密钥的人授予<strong>远程代码执行</strong>能力。请仅在您掌控的、受信任且已加固的站点上启用。您的 MCP API 密钥和插件自身的设置仍受保护。"

#: admin/class-mcp-admin.php:989
msgid "Save Settings"
msgstr "保存设置"

#: admin/class-mcp-admin.php:999
msgid "Audit log is not available. Please deactivate and reactivate the plugin."
msgstr "审计日志不可用。请停用并重新启用该插件。"

#: admin/class-mcp-admin.php:1023
msgid "Structured log of all MCP tool calls, errors, and auth events. Auto-pruned after 30 days."
msgstr "所有 MCP 工具调用、错误和身份验证事件的结构化日志。30 天后自动清除。"

#: admin/class-mcp-admin.php:1030 admin/class-mcp-admin.php:1085
msgid "Event"
msgstr "事件"

#: admin/class-mcp-admin.php:1032
