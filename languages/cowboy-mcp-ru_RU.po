msgid "Add this to your <code>opencode.json</code>:"
msgstr "Добавьте это в ваш <code>opencode.json</code>:"

#: admin/class-mcp-admin.php:751
msgid ""
"Add this to <code>~/.cursor/mcp.json</code> (create the file if it does not "
"exist), then reload Cursor:"
msgstr ""
"Добавьте это в <code>~/.cursor/mcp.json</code> (создайте файл, если его "
"нет), затем перезагрузите Cursor:"

#: admin/class-mcp-admin.php:772
msgid "Copy setup command"
msgstr "Скопировать команду настройки"

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:783
#, php-format
msgid ""
"Open a new Claude Code session and run <code>/mcp</code> — <code>%s</code> "
"should be listed as connected."
msgstr ""
"Откройте новую сессию Claude Code и выполните <code>/mcp</code> — <code>%s</"
"code> должен отображаться как подключённый."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:785
#, php-format
msgid ""
"Run <code>codex mcp list</code> — <code>%s</code> should appear in the list."
msgstr ""
"Выполните <code>codex mcp list</code> — <code>%s</code> должен появиться в "
"списке."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:787
#, php-format
msgid ""
"Restart Opencode and ask it to list its MCP servers — <code>%s</code> should "
"be available."
msgstr ""
"Перезапустите Opencode и попросите вывести список MCP-серверов — <code>%s</"
"code> должен быть доступен."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:789
#, php-format
msgid ""
"Open <code>Cursor Settings → MCP</code> — <code>%s</code> should appear with "
"a green status dot."
msgstr ""
"Откройте <code>Cursor Settings → MCP</code> — <code>%s</code> должен "
"появиться с зелёным индикатором состояния."

#. translators: %s: the MCP server name shown in the client.
#: admin/class-mcp-admin.php:791
#, php-format
msgid ""
"Run <code>gemini mcp list</code> — <code>%s</code> should show as connected."
msgstr ""
"Выполните <code>gemini mcp list</code> — <code>%s</code> должен отображаться "
"как подключённый."

#: admin/class-mcp-admin.php:798
