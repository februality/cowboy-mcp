#: admin/class-mcp-admin-activity.php:52
msgid ""
"Every change an agent makes is journaled with its before-state. Undo a "
"single change, or roll the whole database back to a checkpoint."
msgstr ""
"Cada alteração feita por um agente é registrada com o estado anterior. "
"Desfaça uma única alteração ou reverta todo o banco de dados para um ponto "
"de verificação."

#: admin/class-mcp-admin-activity.php:64
msgid "Change journal"
msgstr "Diário de alterações"

#: admin/class-mcp-admin-activity.php:67
msgid "No changes match these filters."
msgstr "Nenhuma alteração corresponde a esses filtros."

#: admin/class-mcp-admin-activity.php:67
msgid "No journaled changes yet."
msgstr "Nenhuma alteração registrada no diário ainda."

